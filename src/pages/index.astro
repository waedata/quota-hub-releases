---
import "../styles/global.css";

const GITHUB_REPO = "https://github.com/waedata/quota-hub-releases";
const DOWNLOAD_URL = `${GITHUB_REPO}/releases`;

const features = [
  { num: "01", title: "集中监控", src: "/product/01.png", alt: "Token 订阅额度集中监控", lead: true },
  { num: "02", title: "周期折算", src: "/product/02.png", alt: "不同周期额度折算展示" },
  { num: "03", title: "重置窗口", src: "/product/03.png", alt: "额度重置窗口展示" },
  { num: "04", title: "消耗分析", src: "/product/04.png", alt: "Token 消耗汇总分析" },
  { num: "05", title: "到期提醒", src: "/product/05.jpg", alt: "订阅到期时间提醒", danger: true },
  { num: "06", title: "快速接入", src: "/product/06.png", alt: "监控账户添加方便" }
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Quota Hub —— 一站式 Token 额度与订阅监控桌面控制台。"
    />
    <link rel="icon" type="image/png" href="/icons/quota-hub.png" />
    <link rel="apple-touch-icon" href="/icons/quota-hub.png" />
    <title>Quota Hub | Token 额度与订阅监控</title>
  </head>
  <body>
    <main>
      <header class="nav" id="nav">
        <a class="brand" href="#top" aria-label="Quota Hub">
          <img src="/icons/quota-hub.png" alt="" />
          <span>Quota Hub</span>
        </a>
        <nav class="nav-links">
          <a href="#features">功能</a>
          <a class="nav-gh" href={GITHUB_REPO} aria-label="GitHub 仓库">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a class="nav-cta" href="/join">联系我们 →</a>
        </nav>
      </header>

      <section class="hero" id="top">
        <div class="hero-atmosphere" aria-hidden="true">
          <div class="hero-glow"></div>
          <div class="hero-grid"></div>
        </div>
        <div class="hero-content">
          <p class="eyebrow">
            <span class="os-pill">macOS</span>
            <span class="os-pill">Windows</span>
            <span class="os-sep">·</span>
            <span class="os-note">desktop console</span>
          </p>
          <h1 class="hero-title" aria-label="Quota Hub">
            <img class="hero-q" src="/icons/quota-hub.png" alt="" aria-hidden="true" />
            <span class="hero-title-text" aria-hidden="true">uota Hub</span>
          </h1>
          <p class="tagline">看 token,一个窗口就够。</p>
          <div class="hero-actions">
            <a class="button primary" href={DOWNLOAD_URL}>
              <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
              GitHub 下载
            </a>
            <a class="button ghost" href="/join">联系我们</a>
          </div>
        </div>
        <figure class="hero-stage" id="heroStage">
          <div class="stage-glow" aria-hidden="true"></div>
          <div class="stage-frame">
            <img src="/product/01.png" alt="Quota Hub 产品总览" />
          </div>
          <div class="stage-floor" aria-hidden="true"></div>
        </figure>
      </section>

      <section class="features-section" id="features" aria-label="核心功能">
        <header class="section-label">
          <span class="dot"></span>
          <span>能力 · Capabilities</span>
        </header>

        {features.map((f, i) => (
          <article class={`feature reveal ${i % 2 === 0 ? "align-left" : "align-right"}${f.lead ? " is-lead" : ""}${f.danger ? " is-danger" : ""}`}>
            <div class="feature-head">
              <span class="num">{f.num}</span>
              <h2>{f.title}</h2>
              {f.danger && <span class="pulse" aria-hidden="true"></span>}
            </div>
            <figure class="feature-media">
              <div class="media-glow" aria-hidden="true"></div>
              <img src={f.src} alt={f.alt} loading="lazy" />
            </figure>
          </article>
        ))}
      </section>

      <section class="cta">
        <div class="cta-glow" aria-hidden="true"></div>
        <h2>获取下载,开始使用。</h2>
        <p class="cta-sub">GitHub 下载最新版本,或扫码联系我们。</p>
        <div class="cta-actions">
          <a class="button primary" href={DOWNLOAD_URL}>
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
            GitHub 下载
          </a>
          <a class="button ghost" href="/join">微信 / 飞书联系</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-brand">
        <a class="brand" href="#top" aria-label="Quota Hub">
          <img src="/icons/quota-hub.png" alt="" />
          <span>Quota Hub</span>
        </a>
        <p>token 额度与订阅监控桌面控制台</p>
      </div>
      <nav class="footer-links" aria-label="页脚导航">
        <a href="#features">功能介绍</a>
        <a href="/join">联系我们</a>
        <a href={DOWNLOAD_URL}>版本下载</a>
        <a href={`${GITHUB_REPO}/issues`}>问题反馈</a>
        <a class="gh-link" href={GITHUB_REPO} target="_blank" rel="noopener">
          <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub 仓库
        </a>
      </nav>
      <div class="footer-copy">
        <span>© 2026 Quota Hub</span>
        <a href="mailto:285564292@qq.com">285564292@qq.com</a>
        <span>macOS / Windows</span>
      </div>
    </footer>

    <script>
      // 1. 滚动时给 nav 加阴影/细线
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav.classList.add("scrolled");
        else nav.classList.remove("scrolled");
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();

      // 2. reveal 揭示
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));

      // 3. Hero 视差(scroll-linked depth)
      const stage = document.getElementById("heroStage");
      const onParallax = () => {
        const y = window.scrollY;
        if (y > 900) return;
        const t = Math.min(y / 900, 1);
        stage.style.setProperty("--py", `${t * 60}px`);
        stage.style.setProperty("--ps", `${1 - t * 0.06}`);
      };
      window.addEventListener("scroll", onParallax, { passive: true });
      onParallax();
    </script>
  </body>
</html>
