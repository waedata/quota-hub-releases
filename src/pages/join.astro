---
import "../styles/global.css";

const GITHUB_REPO = "https://github.com/waedata/quota-hub-releases";
const DOWNLOAD_URL = `${GITHUB_REPO}/releases`;
const ISSUES_URL = `${GITHUB_REPO}/issues`;

const contacts = [
  { name: "微信", img: "/group/corehub-weichat-oneway.jpg", caption: "WeChat" },
  { name: "飞书", img: "/group/corehub-feishu-oneway.jpg", caption: "Feishu / Lark" }
];

const faqs = [
  ["支持哪些平台?", "OpenAI、DeepSeek、智谱 GLM、火山方舟、MiniMax、OpenCode Go 等主流 AI 平台。"],
  ["数据是否上传云端?", "Quota Hub 是桌面客户端,优先利用本机会话和安全凭证完成监控,不上传敏感数据。"],
  ["如何新增监控账户?", "在监控账户页面几步即可完成新增,支持配置本地凭证、计费模式与监控频率。"],
  ["订阅方案是什么?", "具体订阅方案与获取方式请扫码联系我们,或前往 GitHub Releases 查看最新版本。"]
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="通过微信或飞书联系 Quota Hub,获取桌面客户端、订阅下载与使用支持。"
    />
    <link rel="icon" href="/brand/quota-hub-mark.svg" />
    <title>联系我们 | Quota Hub</title>
  </head>
  <body>
    <main>
      <header class="nav" id="nav">
        <a class="brand" href="/" aria-label="Quota Hub">
          <img src="/brand/quota-hub-mark.svg" alt="" />
          <span>Quota Hub</span>
        </a>
        <nav class="nav-links">
          <a href="/#features">功能</a>
          <a class="nav-gh" href={GITHUB_REPO} aria-label="GitHub 仓库">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          </a>
          <a class="nav-cta" href="/">返回首页 →</a>
        </nav>
      </header>

      <section class="join-hero">
        <p class="eyebrow">
          <span class="os-note">Contact us</span>
        </p>
        <h1>联系我们</h1>
        <p class="lead">微信或飞书扫码,获取桌面客户端、订阅下载与使用支持。</p>
      </section>

      <section class="join-card">
        <div class="qr-row">
          {contacts.map((c) => (
            <div class="qr">
              <div class="qr-frame">
                <img src={c.img} alt={`${c.name}二维码`} loading="lazy" />
              </div>
              <span class="qr-caption">{c.name} · {c.caption}</span>
            </div>
          ))}
        </div>
        <ul class="benefits">
          <li>最新版本优先下载</li>
          <li>订阅与激活说明</li>
          <li>使用问题答疑</li>
          <li>
            <a class="issue-link" href={ISSUES_URL} target="_blank" rel="noopener">新功能建议 / BUG 反馈 →</a>
          </li>
        </ul>
      </section>

      <section class="download-band">
        <div class="cta-glow" aria-hidden="true"></div>
        <h2>也可以直接从 GitHub 下载。</h2>
        <a class="button primary" href={DOWNLOAD_URL}>
          <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
          GitHub 下载
        </a>
      </section>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">常见问题</h2>
        {faqs.map(([q, a]) => (
          <details>
            <summary>{q}</summary>
            <p>{a}</p>
          </details>
        ))}
      </section>

      <section class="contact">
        <p>其他联系方式:<a href="mailto:contact@example.com">contact@example.com</a></p>
      </section>
    </main>

    <footer class="footer">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label="Quota Hub">
          <img src="/brand/quota-hub-mark.svg" alt="" />
          <span>Quota Hub</span>
        </a>
        <p>token 额度与订阅监控桌面控制台</p>
      </div>
      <nav class="footer-links" aria-label="页脚导航">
        <a href="/#features">功能</a>
        <a href="/">首页</a>
        <a href={GITHUB_REPO}>GitHub</a>
      </nav>
      <div class="footer-copy">
        <span>© 2026 Quota Hub</span>
        <span>macOS / Windows</span>
      </div>
    </footer>

    <script>
      const nav = document.getElementById("nav");
      const onScroll = () => {
        if (window.scrollY > 12) nav.classList.add("scrolled");
        else nav.classList.remove("scrolled");
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>
